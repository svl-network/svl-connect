<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@Launcher_AppID@</id>
  <name>Sunveil Connect</name>
  <summary>Custom Minecraft Launcher to easily manage multiple Minecraft installations at once</summary>
  <developer id="net.sunveil.connect">
    <name>Sunveil Contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Sunveil Connect is a custom next-gen launcher for Minecraft that focuses on zero-portforwarding encrypted relay play, automatic mod delta synchronization, and security.</p>
    <p>Features:</p>
    <ul>
      <li>Direct zero-portforwarding multiplayer connection to Sunveil Network realms</li>
      <li>Automatic delta synchronization of mods and anti-cheat modules</li>
      <li>Add manual custom standalone Minecraft servers with one click</li>
      <li>Easily install game modifications, such as Fabric, Forge, NeoForge, and Quilt</li>
      <li>Discover and install mods and modpacks directly from Modrinth and CurseForge</li>
      <li>Control your Java settings, memory allocation, and performance flags</li>
      <li>Manage worlds, shaderpacks, and resource packs from the launcher</li>
      <li>Integrated modern dark mode interface tailored for Minecraft enthusiasts</li>
    </ul>
  </description>
  <releases>
    <release version="@Launcher_VERSION_NAME@" date="@Launcher_BUILD_TIMESTAMP@"></release>
  </releases>
  <url type="homepage">https://sunveil.net/</url>
  <url type="bugtracker">https://github.com/svl-network/svl-connect/issues</url>
  <url type="faq">https://sunveil.net/</url>
  <url type="help">https://sunveil.net/</url>
  <url type="contact">https://discord.gg/sunveil</url>
  <url type="vcs-browser">https://github.com/svl-network/svl-connect</url>
  <url type="contribute">https://github.com/svl-network/svl-connect/blob/main/CONTRIBUTING.md</url>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@Launcher_AppID@.desktop</launchable>
</component>
